# Copy to .env.local for `pnpm dev`. Values match docker-compose.yml and its Keycloak realm.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
KEYCLOAK_ISSUER=http://localhost:8081/realms/sarafrika
KEYCLOAK_CLIENT_ID=mpesa-ui
# Only when the issuer above is not reachable from the Next.js server (inside docker-compose).
KEYCLOAK_INTERNAL_ISSUER=
MPESA_SERVICE_URL=http://localhost:8080
